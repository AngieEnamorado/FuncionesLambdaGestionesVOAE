# Copia este archivo a .env.local (git lo ignora) y llena los datos.
# Solo lo lee infra/servidor-local.mjs: con esto la funcion local se conecta
# a esta base en vez de leer secreto-voae de AWS. Las Lambdas desplegadas no
# lo usan.
#
# Sirve para probar contra el SQL Server de la universidad desde una PC que
# este en su red. Si borras VOAE_DB_SERVER, vuelve a usar Azure.

VOAE_DB_SERVER=10.8.x.x
VOAE_DB_PORT=1433
VOAE_DB_NAME=DbGestionProcesosVoae
VOAE_DB_USER=usuario_app
VOAE_DB_PASSWORD=

# El servidor de la universidad suele tener certificado propio (autofirmado).
VOAE_DB_TRUST_SERVER_CERTIFICATE=true

# Las consultas a Registro pasan por linked server y tardan mas que en Azure.
VOAE_DB_REQUEST_TIMEOUT_MS=20000
